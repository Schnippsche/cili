# Telegram API-Zugangsdaten
# Erstellen unter: https://my.telegram.org/apps → "API development tools"
TG_API_ID=111111111111
TG_API_HASH=111111111111111

# Deine Telegram-Telefonnummer (mit Ländervorwahl)
TG_PHONE=+491738159653

# Telegram-Gruppe: öffentlicher Gruppenname (@gruppenname), Einladungslink oder numerische ID
TG_GROUP=@meinegruppe

# Eindeutiger Bezeichner dieser Quelle — pro Telegram-Gruppe unterschiedlich,
# steuert die pro-Quelle-State-Datei und den source-Wert des Testimonials
TG_SOURCE=meine-quelle

# Lokale KI — Standard: Ollama mit llama3
# Ollama:     http://localhost:11434/v1/chat/completions  (Modell: llama3, mistral, ...)
# LM Studio:  http://localhost:1234/v1/chat/completions   (Modell: beliebig, wird ignoriert)
AI_URL=http://localhost:11434/v1/chat/completions
AI_MODEL=llama3
AI_TIMEOUT=60

# CILI-Zugangsdaten
CILI_URL=http://localhost:8080
CILI_USER=admin
CILI_PASS=admin

# Mindest-Konfidenz der KI für den Import (0.0–1.0)
MIN_CONFIDENCE=0.75

# Webinar-Aufzeichnungen: CILI-Ordner-ID, in den Loom/Video-Links hochgeladen werden
# Leer lassen → Webinar-Nachrichten werden nur übersprungen, nicht heruntergeladen
WEBINAR_FOLDER_ID=

# Maximale Auflösung beim Video-Download (Standard: 720, passend zum CILI-Transkodierungs-Ziel)
WEBINAR_MAX_HEIGHT=720
