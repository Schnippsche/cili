# Telegram API-Zugangsdaten
# Erstellen unter: https://my.telegram.org/apps → "API development tools"
TG_API_ID=111111111111
TG_API_HASH=111111111111111

# Deine Telegram-Telefonnummer (mit Ländervorwahl)
TG_PHONE=+491738159653

# Telegram-Gruppe: öffentlicher Gruppenname (@gruppenname), Einladungslink oder numerische ID
TG_GROUP=@meinegruppe

# Kategorie dieser Telegram-Quelle — muss exakt "Mensch" oder "Tier" sein.
# Legt fest, ob importierte Erfahrungsberichte als Mensch- oder Tier-Bericht angelegt werden.
TG_SOURCE=Mensch

# Lokale KI — nur Ollama (native /api/generate-Route, kein OpenAI-kompatibles Backend
# wie LM Studio mehr — siehe Kommentar bei classify_with_ai() in telegram_import.py)
AI_URL=http://localhost:11434
AI_MODEL=llama3
AI_TIMEOUT=300
AI_NUM_CTX=4096
AI_NUM_PREDICT=1024
AI_RETRY_BACKOFF_SECONDS=15

# CILI-Zugangsdaten
CILI_URL=http://localhost:8080
CILI_USER=admin
CILI_PASS=admin

# Mindest-Konfidenz der KI für den Import (0.0–1.0)
MIN_CONFIDENCE=0.75

# Begrenzung pro Lauf (Backlog wird über mehrere Nächte gestreckt statt in einem Rutsch)
MAX_MESSAGES_PER_RUN=50
MAX_RUNTIME_MINUTES=45

# Webinar-Aufzeichnungen: CILI-Ordner-ID, in den Loom/Video-Links hochgeladen werden
# Leer lassen → Webinar-Nachrichten werden nur übersprungen, nicht heruntergeladen
WEBINAR_FOLDER_ID=

# Maximale Auflösung beim Video-Download (Standard: 720, passend zum CILI-Transkodierungs-Ziel)
WEBINAR_MAX_HEIGHT=720

# Für Testläufe: Webinar-Video-Download/-Upload komplett überspringen (dauert lange),
# ohne WEBINAR_FOLDER_ID selbst anfassen zu müssen.
SKIP_WEBINARS=false

# Schlanke Transkription (Klassifikationshilfe bei Video-/Audio-Anhängen mit
# kurzer/fehlender Bildunterschrift — Defaults gespiegelt von application.yml:
# cili.whisper). Benötigt das faster-whisper-Paket (siehe Skript-Docstring).
# Ohne GPU: WHISPER_DEVICE=cpu und WHISPER_COMPUTE_TYPE=int8 setzen.
# Achtung: nutzt dieselbe GPU wie die Backend-Video-Pipeline (Transcode +
# echte Untertitel) und die Ollama-Klassifikation — diesen Import-Lauf nach
# Möglichkeit nicht parallel zu einer aktiven Backend-Video-Warteschlange
# starten (GPU-Speicher-Konkurrenz).
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANG=auto
