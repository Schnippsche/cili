# Telegram API-Zugangsdaten
# Erstellen unter: https://my.telegram.org/apps → "API development tools"
TG_API_ID=111111111111
TG_API_HASH=111111111111111

# Deine Telegram-Telefonnummer (mit Ländervorwahl)
TG_PHONE=+491511234567

# Telegram-Gruppe: öffentlicher Gruppenname (@gruppenname), Einladungslink oder numerische ID
TG_GROUP=@meinegruppe

# CILI-Zugangsdaten
CILI_URL=http://localhost:8080
CILI_USER=admin
CILI_PASS=admin

# Webinar-Aufzeichnungen: CILI-Ordner-ID, in den Loom/Video-Links hochgeladen werden (Pflicht)
WEBINAR_FOLDER_ID=

# Maximale Auflösung beim Video-Download (Standard: 720, passend zum CILI-Transkodierungs-Ziel)
WEBINAR_MAX_HEIGHT=720

# Für Testläufe: Webinar-Video-Download/-Upload komplett überspringen (dauert lange),
# ohne WEBINAR_FOLDER_ID selbst anfassen zu müssen.
SKIP_WEBINARS=false

# Begrenzung pro Lauf — zählt alle gescannten Nachrichten, nicht nur Webinare (die
# meisten Nachrichten der Gruppe sind Erfahrungsberichte, keine Webinar-Ankündigungen).
# Bei einem wöchentlichen Lauf müssen daher deutlich mehr als "1 Webinar pro Woche"
# an Nachrichten durchsucht werden können — MAX_RUNTIME_MINUTES bleibt die eigentliche
# Bremse für den teuren Pfad (Video-Download/-Upload).
MAX_MESSAGES_PER_RUN=500
MAX_RUNTIME_MINUTES=45
